# Display name for the backend; optional, core application.
APP_NAME=OSINT Toolkit
# Runtime label; optional, core application.
ENVIRONMENT=development
# Logging verbosity; optional, core application.
LOG_LEVEL=INFO
# DNS per-attempt timeout seconds; optional, domain_intel.
DNS_TIMEOUT_SECONDS=5
# DNS total lifetime seconds; optional, domain_intel.
DNS_LIFETIME_SECONDS=10
# Shodan key; required only for live network_recon lookups.
SHODAN_API_KEY=
# XposedOrNot base URL; optional, breach_check needs no key.
XON_BASE_URL=https://api.xposedornot.com
