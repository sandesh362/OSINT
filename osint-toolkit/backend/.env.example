# Copy this file to backend/.env and adjust only if needed.
APP_NAME=OSINT Toolkit
ENVIRONMENT=development
LOG_LEVEL=INFO
DNS_TIMEOUT_SECONDS=5
DNS_LIFETIME_SECONDS=10
# Required for /api/v1/network-recon endpoints. Never commit a real key.
SHODAN_API_KEY=
# Required for /api/v1/breach-check/email. HIBP v3 subscription key; never commit a real key.
BREACH_API_KEY=
